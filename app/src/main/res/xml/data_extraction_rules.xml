<?xml version="1.0" encoding="utf-8"?>
<!--
  OPENOP keeps user data local: no automatic cloud backup (CLAUDE.md §7.1).
  Backups are manual export/import only. Device-to-device transfer is left at
  the Android default for now; decide this with the backup design in Phase 3.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
